{
  "description": "ECC Hooks - Memory Persistence, Strategic Compact & Code Quality (JS/TS, PHP, Python)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm run dev|pnpm( run)? dev|yarn dev|bun run dev)\"",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys; print('[Hook] BLOCKED: Dev server must run in tmux for log access', file=sys.stderr); print('[Hook] Use: tmux new-session -d -s dev \\\"npm run dev\\\"', file=sys.stderr); print('[Hook] Then: tmux attach -t dev', file=sys.stderr); sys.exit(1)\""
          }
        ]
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"(npm (install|test)|pnpm (install|test)|yarn (install|test)?|bun (install|test)|cargo build|make|docker|pytest|vitest|playwright)\"",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,sys; os.environ.get('TMUX') or (print('[Hook] Consider running in tmux for session persistence', file=sys.stderr), print('[Hook] tmux new -s dev  |  tmux attach -t dev', file=sys.stderr))\""
          }
        ]
      },
      {
        "matcher": "tool == \"Bash\" && tool_input.command matches \"git push\"",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys; print('[Hook] Review changes before push...', file=sys.stderr); print('[Hook] Continuing with push (remove this hook to add interactive review)', file=sys.stderr)\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/strategic-compact/suggest-compact.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-persistence/pre-compact.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-persistence/session-start.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tool == \"Bash\"",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json,re; d=sys.stdin.read(); i=json.loads(d) if d.strip() else {}; cmd=i.get('tool_input',{}).get('command',''); out=i.get('tool_output',{}).get('output',''); m=re.search(r'https://github.com/[^/]+/[^/]+/pull/\\d+',out) if 'gh pr create' in cmd else None; m and (print(f'[Hook] PR created: {m.group()}',file=sys.stderr), print(f'[Hook] To review: gh pr review {m.group().split(\"/\")[-1]} --repo {m.group().split(\"/\")[3]}/{m.group().split(\"/\")[4]}',file=sys.stderr)); print(d)\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/format-js.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/check-typescript.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.(ts|tsx|js|jsx)$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/warn-console-log.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.php$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/format-php.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.php$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/check-phpstan.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.php$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/warn-php-debug.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/format-python.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/check-mypy.js\""
          }
        ]
      },
      {
        "matcher": "tool == \"Edit\" && tool_input.file_path matches \"\\\\.py$\"",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/warn-python-debug.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/code-quality/check-debug-code.js\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-persistence/session-end.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory-persistence/evaluate-session.py\""
          }
        ]
      }
    ]
  }
}
